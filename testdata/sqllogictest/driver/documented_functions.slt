# Additional value assertions for documented functions and aliases without
# upstream witnesses. Keep these separate from the unchanged upstream corpus.

query R
SELECT round(cot(pi() / 4))
----
1

query P
SELECT datetrunc('month', TIMESTAMP '2026-09-09 12:34:56')
----
2026-09-01T00:00:00

query ?
SELECT list_sort(list_distinct([3, 1, 3]))
----
[1, 3]

query ?
SELECT list_sort(list_except([1, 2, 3], [2]))
----
[1, 3]

query I
SELECT list_max([1, 3, 2])
----
3

query ?
SELECT list_pop_back([1, 2, 3])
----
[1, 2]

query ?
SELECT list_pop_front([1, 2, 3])
----
[2, 3]

query ?
SELECT list_resize([1, 2], 4, 9)
----
[1, 2, 9, 9]

query ?
SELECT list_reverse([1, 2, 3])
----
[3, 2, 1]

statement ok
SET datafusion.sql_parser.dialect = databricks

query ?
SELECT list_transform([1, 2, 3], x -> x * 2)
----
[2, 4, 6]

statement ok
RESET datafusion.sql_parser.dialect

query ?
SELECT list_sort(list_union([1, 2], [2, 3]))
----
[1, 2, 3]

query ?
SELECT struct(1, 'x')
----
{c0: 1, c1: x}

query ?
SELECT element_at(map(['a', 'b'], [1, 2]), 'b')
----
[2]

query B
SELECT starts_with(version(), 'Apache DataFusion ')
----
true
